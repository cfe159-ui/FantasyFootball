# From https://developer.yahoo.com/apps/create/ (after your access
# application at https://sports.yahoo.com/developer/access/ is approved).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Set automatically by `ff use <league_key>`; can also be set by hand.
FF_LEAGUE_KEY=

# FantasyPros API key (Premium/HOF). Never commit this file.
FANTASYPROS_API_KEY=

# Enables voice conversation with Claude in the app. Billed per token at
# console.anthropic.com; separate from any Claude subscription.
ANTHROPIC_API_KEY=
